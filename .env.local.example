# CharmLink environment variables — copy to .env.local for local development
# Add all of these to Vercel (Settings → Environment Variables) for production.

# REQUIRED: Postgres connection string (Supabase recommended). Use the
# transaction pooler (port 6543) — the app caps its pool at max=3 per
# serverless instance and expects a multiplexing pooler behind it.
# If your password contains special characters (#, @, ?), URL-encode them
# ('#' -> '%23').
DATABASE_URL=postgresql://user:password@host:6543/database

# REQUIRED: Bearer token that gates every /api/admin/* and /api/analytics/*
# route, and the admin dashboard login. Generate with: openssl rand -hex 32
CHARMLINK_ADMIN_KEY=<replace_with_a_strong_random_key>

# REQUIRED: 64-char hex secret for HMAC link tokens.
# Generate with: openssl rand -hex 32
# Must be set in Vercel (production + preview + dev) before merge. In
# production the app refuses to start without this — there is no fallback.
CHARMLINK_LINK_TOKEN_SECRET=<replace_with_64_char_hex_from_openssl_rand_hex_32>

# OPTIONAL: Vercel KV — enables per-IP sliding-window rate limiting and
# honeypot ban list. If unset, rate limiting is silently disabled (no errors).
# Provision via: Vercel Dashboard → Storage → KV → Create → copy env vars.
KV_REST_API_URL=<vercel_kv_rest_api_url>
KV_REST_API_TOKEN=<vercel_kv_rest_api_token>

# OPTIONAL: Vercel Blob — required for the admin avatar upload endpoint
# (/api/admin/avatar). Auto-injected by Vercel once a Blob store is connected
# to the project (Storage → Blob → Create/Connect); not needed for local dev
# unless you're testing avatar uploads. If you add Blob to a project AFTER
# its latest build, force a redeploy — the token isn't retroactively
# injected into an already-built deployment.
BLOB_READ_WRITE_TOKEN=<vercel_blob_read_write_token>

# OPTIONAL: Vercel Domains API — required for custom-domain management
# (add/remove domains via the admin dashboard). If unset, domain management
# is unavailable but the rest of the app works normally.
VERCEL_API_TOKEN=<vercel_api_token>
VERCEL_PROJECT_ID=<vercel_project_id>
# Only needed if the project lives under a Vercel team — auto-resolved
# (env → cached file → /v2/teams API) if omitted.
VERCEL_TEAM_ID=<vercel_team_id>

# OPTIONAL (Phase 3): Cloudflare API token — enables automatic CF zone provisioning
# (orange-cloud CNAME, WAF rules, transform rules) when adding domains via admin API.
# If unset, CF provisioning is silently skipped (Vercel domain still added).
# Token must have Zone:DNS:Edit + Zone:Settings:Edit + Zone:Firewall Services:Edit
# on all CharmLink zones. Scoped token — NOT the global API key.
CLOUDFLARE_API_TOKEN=<cfat_...>
# Required alongside CLOUDFLARE_API_TOKEN to sync Turnstile widget hostnames
# when adding/removing domains.
CLOUDFLARE_ACCOUNT_ID=<cloudflare_account_id>

# OPTIONAL: set to "1" to enable Cloudflare Bot Fight Mode on newly
# provisioned zones. Leave unset — Free-tier BFM blocks real Chrome users.
CHARMLINK_ENABLE_BFM=

# OPTIONAL (Phase 3): Cloudflare Turnstile — escalates suspicious requests to
# human verification. Both keys must be set to enable Turnstile.
# Provision: CF Dashboard → Turnstile → Add site → Managed mode → copy keys.
# If unset, Turnstile gate is skipped (all non-bot requests pass through).
TURNSTILE_SECRET_KEY=<cloudflare_turnstile_secret_key>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<cloudflare_turnstile_site_key>
